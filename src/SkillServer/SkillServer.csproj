<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>$(NetLibVersion)</TargetFramework>
    <RootNamespace>SkillServer</RootNamespace>
    <AssemblyName>SkillServer</AssemblyName>
  </PropertyGroup>

  <!-- AOT Preparation (MVC not fully AOT-compatible yet, but we prepare where possible) -->
  <PropertyGroup>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Container Publishing -->
  <PropertyGroup>
    <ContainerRepository>skillserver</ContainerRepository>
    <ContainerImageTags>latest;$(Version)</ContainerImageTags>
    <ContainerFamily>alpine</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>

</Project>
